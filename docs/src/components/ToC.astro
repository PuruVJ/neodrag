---
import type { MarkdownHeading } from 'astro';

type Props = {
	headings: MarkdownHeading[];
};

const { headings } = Astro.props;
---

<aside aria-label="Links to sections in this Page" class="grid h-full w-full items-center">
	<p class="site-kicker mb-3 pl-3">on this page</p>
	<nav class="border-l-2 border-[var(--color-border)] pl-3">
		<ul class="m-0 list-none p-0">
			{
				headings.map(({ depth, slug, text }) => (
					<li
						class="h-[1.4rem] py-0 transition-colors duration-100"
						style={`padding-left: calc(${(depth - 2) * 0.5}rem)`}
					>
						<a
							href={`#${slug}`}
							class="unstyled m-0! text-xs! leading-none! text-[color-mix(in_lch,var(--app-color-dark),transparent_30%)] hover:text-brand"
						>
							{text}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</aside>
