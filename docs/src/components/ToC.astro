---
import type { MarkdownHeading } from 'astro';
import type { HTMLAttributes } from 'astro/types';

type Props = {
	headings: MarkdownHeading[];
	class?: string;
} & HTMLAttributes<'nav'>;

const { headings, class: className, ...rest } = Astro.props;
---

<nav class:list={['docs-toc-nav', className]} aria-label="On this page" {...rest}>
	<p class="site-kicker docs-toc-kicker">on this page</p>
	<ul class="docs-toc-list m-0 list-none p-0">
		{
			headings.map(({ depth, slug, text }) => (
				<li class="docs-toc-item" data-depth={depth}>
					<a href={`#${slug}`} class="docs-toc-link unstyled">
						{text}
					</a>
				</li>
			))
		}
	</ul>
</nav>
