---
import { Code } from 'astro/components';
import type { Framework } from '$helpers/constants';
import { FRAMEWORK_TABS } from './frameworks';
import { get_snippet, LANG_BY_FRAMEWORK } from './snippet-templates';
import { WORLDS, type WorldId } from './worlds';

const SHIKI_THEMES = {
	light: 'github-light',
	dark: 'github-dark',
} as const;
---

<div class="playground-snippets relative min-h-full">
	{
		WORLDS.map((world) =>
			FRAMEWORK_TABS.map((tab) => (
				<div
					class="playground-snippet"
					data-world={world.id}
					data-framework={tab.id}
					hidden
				>
					<Code
						code={get_snippet(world.id as WorldId, tab.id as Framework)}
						lang={LANG_BY_FRAMEWORK[tab.id]}
						themes={SHIKI_THEMES}
						wrap
					/>
				</div>
			)),
		)
	}
</div>
