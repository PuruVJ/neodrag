---
import { get_nav_list } from '$/nav';
import Nav from '$components/docs/Nav.svelte';
import MetaThemeColor from '$components/MetaThemeColor.svelte';
import ToC from '$components/ToC.astro';
import type { Framework } from '$helpers/constants';
import type { MarkdownHeading } from 'astro';
import Layout from './Layout.astro';

type Props = {
	title: string;
	headings: MarkdownHeading[];
	framework: Framework;
};

const { title, headings, framework } = Astro.props;
const nav_list = get_nav_list(framework as any);
---

<MetaThemeColor client:load />
<Layout title={title}>
	<div
		class="pointer-events-none fixed inset-0 z-0 docs-grid-backdrop"
		aria-hidden="true"
		transition:persist="docs-grid"
	></div>

	<section
		class="relative z-[1] h-dvh w-full overflow-x-hidden overflow-y-auto scroll-smooth max-[967px]:grid max-[967px]:grid-cols-1"
		id="docs-container"
	>
		<aside
			class="docs-sidebar-panel fixed z-10 hidden h-full w-[300px] overflow-y-auto min-[968px]:block"
		>
			<Nav framework={framework} pathname={Astro.url.pathname} nav_list={nav_list} />
		</aside>

		<main
			class="docs-shell relative min-h-dvh w-full min-w-0 min-[968px]:w-[calc(100%-300px)] min-[968px]:pl-[300px]"
		>
			<article class="docs-article-panel docs-prose">
				<slot />

				<div class="site-section-break mt-12" aria-hidden="true">
					<span class="site-section-break-line"></span>
					<span class="font-mono text-sm font-black">§</span>
					<span class="site-section-break-line"></span>
				</div>

				<footer class="mt-6 flex w-full justify-center">
					<span class="font-mono text-xs tracking-[0.12em] text-fg-muted uppercase">
						&copy; 2021-{new Date().getUTCFullYear()}
						<a
							href="https://x.com/puruvjdev"
							target="blank"
							rel="noopener noreferrer"
							class="unstyled font-extrabold text-brand normal-case"
						>
							Puru Vijay</a
						>
					</span>
				</footer>
			</article>
		</main>

		<aside
			class="toc fixed top-0 right-5 z-10 hidden h-full w-[280px] min-[1200px]:block"
		>
			<ToC headings={headings} />
		</aside>
	</section>
</Layout>
