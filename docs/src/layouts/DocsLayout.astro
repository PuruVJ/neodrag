---
import { get_nav_list } from '$/nav';
import Nav from '$components/docs/Nav.svelte';
import MetaThemeColor from '$components/MetaThemeColor.svelte';
import ToC from '$components/ToC.astro';
import type { Framework } from '$helpers/constants';
import type { MarkdownHeading } from 'astro';
import Layout from './Layout.astro';

type Props = {
	title: string;
	headings: MarkdownHeading[];
	framework: Framework;
};

const { title, headings, framework } = Astro.props;
const nav_list = get_nav_list(framework as any);
---

<MetaThemeColor client:load />
<Layout title={title}>
	<div class="pointer-events-none fixed inset-0 z-0" aria-hidden="true">
		<div class="site-grid-layer absolute inset-0"></div>
		<div class="site-glow-layer absolute inset-0"></div>
	</div>

	<section
		class="relative z-10 h-auto w-full overflow-x-hidden overflow-y-auto scroll-smooth max-[967px]:grid max-[967px]:grid-cols-1"
		id="docs-container"
	>
		<aside
			class="fixed z-10 hidden h-full w-[300px] overflow-y-auto border-r-2 border-[var(--color-border)] bg-[color-mix(in_lch,var(--app-color-shell),transparent_8%)] backdrop-blur-md min-[968px]:block"
		>
			<Nav framework={framework} pathname={Astro.url.pathname} nav_list={nav_list} />
		</aside>

		<main
			class="relative min-h-dvh w-full min-w-0 pt-10 pr-4 pb-8 pl-4 min-[968px]:w-[calc(100%-300px)] min-[968px]:pl-[332px]"
		>
			<article class="docs-prose pb-12">
				<slot />

				<footer class="mt-12 flex w-full justify-center">
					<span class="flex items-center gap-2 font-mono text-sm text-fg-muted">
						&copy; 2021-{new Date().getUTCFullYear()}
						<a
							href="https://x.com/puruvjdev"
							target="blank"
							rel="noopener noreferrer"
							class="unstyled font-semibold text-brand"
						>
							Puru Vijay</a
						>
					</span>
				</footer>
			</article>
		</main>

		<aside
			class="toc fixed top-0 right-5 z-10 hidden h-full w-[280px] min-[1200px]:block"
		>
			<ToC headings={headings} />
		</aside>
	</section>
</Layout>
