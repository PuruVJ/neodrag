---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/app.css';

import { get_nav_list } from '$/nav';
import Dock from '$components/nav/Dock.svelte';
import PawCursor from '$components/PawCursor.svelte';
import { framework_from_path, is_docs_path } from '$helpers/framework-route';
import { SEO } from 'astro-seo';
import { ClientRouter } from 'astro:transitions';

export interface Props {
	title: string;
}

const { title } = Astro.props;

const framework = framework_from_path(Astro.url.pathname);
const is_docs_route = is_docs_path(Astro.url.pathname);

const nav_by_framework = Object.fromEntries(
	(['svelte', 'react', 'vue', 'solid', 'vanilla', 'core'] as const).map((name) => [
		name,
		get_nav_list(name),
	]),
);
---

<!doctype html>
<html lang="en" data-framework={framework} class:list={[{ 'docs-route': is_docs_route }]}>
	<head>
		<meta charset="UTF-8" />
		<script is:inline>
			(function () {
				const DEFAULT = { current: 'light', preference: 'system' };

				function parse_theme_storage(storage_value) {
					if (!storage_value) return DEFAULT;
					try {
						const parsed = JSON.parse(storage_value) ?? DEFAULT;
						if (parsed.preference !== 'system') {
							parsed.current = parsed.preference;
						}
						return parsed;
					} catch {
						localStorage.removeItem('neodrag:theme');
						return DEFAULT;
					}
				}

				function resolve_theme() {
					const local_theme = parse_theme_storage(localStorage.getItem('neodrag:theme'));
					if (local_theme.preference === 'system') {
						return matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
					}
					return local_theme.preference;
				}

				function apply_neodrag_theme() {
					const theme = resolve_theme();
					document.documentElement.dataset.theme = theme;
					document.documentElement.style.colorScheme = theme;
				}

				window.__neodrag_apply_theme = apply_neodrag_theme;
				apply_neodrag_theme();

				const FRAMEWORK_PATH_RE = /\/docs\/(svelte|react|solid|vanilla|vue|core)/i;

				function apply_docs_framework_from_path(pathname) {
					const match = FRAMEWORK_PATH_RE.exec(pathname);
					const framework = match?.[1];

					if (framework) {
						document.documentElement.dataset.framework = framework;
					} else {
						delete document.documentElement.dataset.framework;
					}
				}

				apply_docs_framework_from_path(location.pathname);
			})();
		</script>
		<ClientRouter fallback="swap" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="theme-color" content="black" />

		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

		<link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap-index.xml" />
		<title>{title}</title>

		<SEO
			canonical={`https://next.neodrag.dev${Astro.url.pathname}`}
			description="Your one stop solution for anything draggable with JavaScript. Adapters for React, Svelte, Vue, SolidJS and JavaScript. Fully TypeScript compliant."
			openGraph={{
				basic: {
					image: 'https://www.neodrag.dev/banner.png',
					title,
					type: 'website',
					url: `https://www.neodrag.dev${Astro.url.pathname}`,
				},
			}}
			twitter={{
				card: 'summary_large_image',
				creator: '@puruvjdev',
				site: 'neodrag.dev',
			}}
		/>
	</head>

	<body class:list={[{ 'docs-route': is_docs_route }]}>
		{
			is_docs_route && (
				<div class="docs-page-grid" aria-hidden="true" />
			)
		}
		<script is:inline data-astro-rerun>
			(function () {
				const FRAMEWORK_PATH_RE = /\/docs\/(svelte|react|solid|vanilla|vue|core)/i;

				function apply_docs_route_context(pathname) {
					const path = pathname ?? location.pathname;
					const framework = FRAMEWORK_PATH_RE.exec(path)?.[1];
					const is_docs = path.startsWith('/docs');

					if (framework) {
						document.documentElement.dataset.framework = framework;
					} else {
						delete document.documentElement.dataset.framework;
					}

					delete document.body.dataset.framework;
					document.documentElement.classList.toggle('docs-route', is_docs);
					document.body.classList.toggle('docs-route', is_docs);
				}

				window.__neodrag_apply_docs_route = apply_docs_route_context;

				window.__neodrag_apply_theme?.();
				apply_docs_route_context();

				document.addEventListener('astro:page-load', () => apply_docs_route_context());
				document.addEventListener('astro:after-swap', () => apply_docs_route_context());

				matchMedia('(prefers-color-scheme: dark)').addEventListener(
					'change',
					window.__neodrag_apply_theme,
				);
				addEventListener('storage', (event) => {
					if (event.key === 'neodrag:theme') window.__neodrag_apply_theme?.();
				});
			})();
		</script>

		<div>
			<Dock
				pathname={Astro.url.pathname}
				framework={framework}
				nav_by_framework={nav_by_framework}
				client:load
			/>
			<slot />
		</div>

		<PawCursor client:only="svelte" />
	</body>
</html>
