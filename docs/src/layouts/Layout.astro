---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/app.css';

import { get_nav_list } from '$/nav';
import Dock from '$components/nav/Dock.svelte';
import PawCursor from '$components/PawCursor.svelte';
import { SEO } from 'astro-seo';
import { ClientRouter } from 'astro:transitions';

export interface Props {
	title: string;
}

const { title } = Astro.props;

const framework = /\/docs\/(svelte|react|solid|vanilla|vue|core)/gi.exec(Astro.url.pathname)?.[1];
const is_docs_route = Astro.url.pathname.startsWith('/docs');

const nav_list = get_nav_list(framework as any);
---

<!doctype html>
<html lang="en">
	<head>
		<ClientRouter fallback="swap" />

		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="theme-color" content="black" />

		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

		<link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap-index.xml" />
		<title>{title}</title>

		<SEO
			canonical={`https://next.neodrag.dev${Astro.url.pathname}`}
			description="Your one stop solution for anything draggable with JavaScript. Adapters for React, Svelte, Vue, SolidJS and JavaScript. Fully TypeScript compliant."
			openGraph={{
				basic: {
					image: 'https://www.neodrag.dev/banner.png',
					title,
					type: 'website',
					url: `https://www.neodrag.dev${Astro.url.pathname}`,
				},
			}}
			twitter={{
				card: 'summary_large_image',
				creator: '@puruvjdev',
				site: 'neodrag.dev',
			}}
		/>
	</head>

	<body data-framework={framework} class:list={[{ 'docs-route': is_docs_route }]}>
		<script is:inline data-astro-rerun>
			function parse_theme_storage(storage_value) {
				const DEFAULT = {
					current: 'light',
					preference: 'system',
				};

				if (!storage_value) return DEFAULT;

				let parsed = null;
				try {
					parsed = JSON.parse(storage_value);
				} catch {
					localStorage.removeItem('neodrag:theme');
				}

				return parsed ?? DEFAULT;
			}

			function apply_neodrag_theme() {
				const local_theme = parse_theme_storage(localStorage.getItem('neodrag:theme'));

				let theme = local_theme.current;
				if (local_theme.preference === 'system') {
					theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				}

				document.body.dataset.theme = theme;
			}

			apply_neodrag_theme();

			window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', apply_neodrag_theme);
			window.addEventListener('storage', (event) => {
				if (event.key === 'neodrag:theme') apply_neodrag_theme();
			});

			window.__neodrag_apply_theme = apply_neodrag_theme;
		</script>

		<div>
			<Dock
				selected={framework}
				pathname={Astro.url.pathname}
				nav_list={nav_list}
				client:only="svelte"
				transition:persist="dock"
			/>
			<slot />
		</div>

		<PawCursor client:only="svelte" />
	</body>
</html>
