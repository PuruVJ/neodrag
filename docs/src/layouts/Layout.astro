---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/app.css';

import { get_nav_list } from '$/nav';
import Dock from '$components/nav/Dock.svelte';
import PawCursor from '$components/PawCursor.svelte';
import { SEO } from 'astro-seo';
import { ClientRouter } from 'astro:transitions';

export interface Props {
	title: string;
}

const { title } = Astro.props;

const framework = /\/docs\/(svelte|react|solid|vanilla|vue|core)/gi.exec(Astro.url.pathname)?.[1];
const is_docs_route = Astro.url.pathname.startsWith('/docs');

const nav_list = get_nav_list(framework ?? '');
---

<!doctype html>
<html lang="en" data-framework={framework}>
	<head>
		<meta charset="UTF-8" />
		<script is:inline>
			(function () {
				const DEFAULT = { current: 'light', preference: 'system' };

				function parse_theme_storage(storage_value) {
					if (!storage_value) return DEFAULT;
					try {
						return JSON.parse(storage_value) ?? DEFAULT;
					} catch {
						localStorage.removeItem('neodrag:theme');
						return DEFAULT;
					}
				}

				function resolve_theme() {
					const local_theme = parse_theme_storage(localStorage.getItem('neodrag:theme'));
					if (local_theme.preference === 'system') {
						return matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
					}
					return local_theme.current;
				}

				function apply_neodrag_theme() {
					const theme = resolve_theme();
					document.documentElement.dataset.theme = theme;
					document.documentElement.style.colorScheme = theme;
				}

				window.__neodrag_apply_theme = apply_neodrag_theme;
				apply_neodrag_theme();
			})();
		</script>
		<ClientRouter fallback="swap" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="theme-color" content="black" />

		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

		<link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap-index.xml" />
		<title>{title}</title>

		<SEO
			canonical={`https://next.neodrag.dev${Astro.url.pathname}`}
			description="Your one stop solution for anything draggable with JavaScript. Adapters for React, Svelte, Vue, SolidJS and JavaScript. Fully TypeScript compliant."
			openGraph={{
				basic: {
					image: 'https://www.neodrag.dev/banner.png',
					title,
					type: 'website',
					url: `https://www.neodrag.dev${Astro.url.pathname}`,
				},
			}}
			twitter={{
				card: 'summary_large_image',
				creator: '@puruvjdev',
				site: 'neodrag.dev',
			}}
		/>
	</head>

	<body data-framework={framework} class:list={[{ 'docs-route': is_docs_route }]}>
		{is_docs_route && <div class="docs-page-grid" aria-hidden="true" />}
		<script is:inline data-astro-rerun>
			window.__neodrag_apply_theme?.();
			matchMedia('(prefers-color-scheme: dark)').addEventListener(
				'change',
				window.__neodrag_apply_theme,
			);
			addEventListener('storage', (event) => {
				if (event.key === 'neodrag:theme') window.__neodrag_apply_theme?.();
			});
		</script>

		<div>
			<Dock
				selected={framework}
				pathname={Astro.url.pathname}
				nav_list={nav_list}
				client:only="svelte"
				transition:persist="dock"
			/>
			<slot />
		</div>

		<PawCursor client:only="svelte" />
	</body>
</html>
