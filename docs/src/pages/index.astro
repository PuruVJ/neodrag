---
import Layout from '$layouts/Layout.astro';
import PlaygroundCodeSnippets from '$components/playground/PlaygroundCodeSnippets.astro';
import PlaygroundHome from '$components/playground/PlaygroundHome.svelte';
---

<Layout title="Neodrag: One draggable to rule them all">
	<main id="main-content" data-astro-reload class="relative z-[2] w-full max-w-full p-0">
		<PlaygroundHome client:only="svelte">
			<PlaygroundCodeSnippets slot="snippets" />
		</PlaygroundHome>
	</main>
</Layout>
