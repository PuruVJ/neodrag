---
import Layout from '$layouts/Layout.astro';
import PlaygroundHome from '$components/playground/PlaygroundHome.svelte';
---

<Layout title="Neodrag: One draggable to rule them all">
	<main id="main-content">
		<PlaygroundHome client:load />
	</main>
</Layout>

<style is:global>
	html {
		overflow-x: hidden;
	}
</style>

<style scoped>
	main {
		position: relative;
		z-index: 2;
		width: 100%;
		max-width: 100%;
		padding: 0;
		box-sizing: border-box;
	}
</style>
