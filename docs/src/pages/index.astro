---
import BundleSizeBuilderFeature from '$components/home/features/bundle-size/BundleSizeBuilderFeature.svelte';
import FeatureRichFeature from '$components/home/features/feature-rich/FeatureRichFeature.svelte';
import MultipleFrameworksFeature from '$components/home/features/multiple-frameworks/MultipleFrameworksFeature.svelte';
import SSRFriendlyFeature from '$components/home/features/ssr-friendly/SSRFriendlyFeature.svelte';
import HeroExample from '$components/home/HeroExample.svelte';
import Layout from '$layouts/Layout.astro';
import { Code } from 'astro/components';
---

<Layout title="Neodrag: One draggable to rule them all">
	<main id="main-content">
		<section class="tagline">
			<div class="intro">
				<h1>Neodrag</h1>
				<p class="h4">One draggable to rule them all</p>

				<br /><br /><br />

				<div class="group">
					<a href="/docs/svelte">Getting Started</a>
					<a href="https://github.com/puruvj/neodrag" target="_blank" rel="external"> Github </a>
				</div>
			</div>

			<div class="demo">
				<HeroExample client:load />
			</div>
		</section>

		<section class="feature feature-multi-frameworks">
			<div>
				<MultipleFrameworksFeature client:visible>
					<div class="svelte">
						<Code
							code={`<script>
  import { draggable } from '@neodrag/svelte';
</script>

<div {@attach draggable()}>I can drag</div>`}
							lang="svelte"
							themes={{
								light: 'github-light',
								dark: 'github-dark',
							}}
							theme={'github-light'}
							wrap={true}
						/>
					</div>

					<div class="react">
						<Code
							code={`import { useDraggable } from '@neodrag/react';

function App() {
  const ref = useRef();
  useDraggable(ref)

  <div ref={ref}>I can drag</div>
}`}
							lang="tsx"
							themes={{
								light: 'github-light',
								dark: 'github-dark',
							}}
							theme={'github-light'}
							wrap={true}
						/>
					</div>

					<div class="solid">
						<Code
							code={`import { useDraggable } from '@neodrag/solid';

function App() {
  const [ref, setRef] = createSignal();
  useDraggable(ref)

  <div ref={setRef}>I can drag</div>
}`}
							lang="tsx"
							themes={{
								light: 'github-light',
								dark: 'github-dark',
							}}
							theme={'github-light'}
							wrap={true}
						/>
					</div>

					<div class="vanilla">
						<Code
							code={`import { Draggable } from '@neodrag/vanilla';
							
const element = document.querySelector('.draggable');
const draggable = new Draggable(element);`}
							lang="tsx"
							themes={{
								light: 'github-light',
								dark: 'github-dark',
							}}
							theme={'github-light'}
							wrap={true}
						/>
					</div>

					<div class="vue">
						<Code
							code={`<script>
  import { vDraggable } from '@neodrag/svelte';
</script>

<div v-draggable>I can drag</div>`}
							lang="vue"
							themes={{
								light: 'github-light',
								dark: 'github-dark',
							}}
							theme={'github-light'}
							wrap={true}
						/>
					</div>
				</MultipleFrameworksFeature>
			</div>
		</section>

		<section class="feature">
			<div>
				<h2>Everything's a plugin!</h2>
			</div>
		</section>

		<section class="feature">
			<div>
				<h2>Keep Elements Inside Boundaries</h2>
			</div>
		</section>

		<section class="feature">
			<div>
				<h2>Lock Movement To Specific Directions</h2>
			</div>
		</section>

		<section class="feature">
			<div>
				<h2>Snap Elements To Perfect Grids</h2>
			</div>
		</section>

		<section class="feature">
			<div>
				<h2>Mix And Match Drag Behaviors</h2>
			</div>
		</section>

		<section class="feature">
			<div>
				<h2>Handle Thousands With 3 Event Listeners</h2>
			</div>
		</section>

		<section class="feature">
			<div>
				<h2>Never Lose Drag Over iframes</h2>
			</div>
		</section>

		<section class="feature">
			<div>
				<h2>Production Ready With Zero Dependencies</h2>
			</div>
		</section>

		<section class="feature feature-transparent two-col">
			<div>
				<BundleSizeBuilderFeature client:visible />
			</div>
		</section>

		<section class="feature feature-ssr-friendly two-col">
			<div>
				<SSRFriendlyFeature client:visible />
			</div>
		</section>

		<section class="feature feature-feature-rich">
			<div>
				<FeatureRichFeature client:visible />
			</div>
		</section>

		<section class="feature feature-feature-rich">
			<div>
				<h2>Astro: How many frameworks?</h2>
				<h3 class="h2">Neodrag: Yes</h3>
			</div>
		</section>
	</main>
</Layout>

<script>
	const thresholds = Array.from({ length: 101 }, (_, i) => i * 0.01);

	const instance = new IntersectionObserver(
		(entries) => {
			entries.forEach((entry) => {
				const target = entry.target.children[0] as HTMLDivElement;
				if (entry.isIntersecting) {
					target.style.scale = `${0.8 + 0.2 * entry.intersectionRatio} ${0.8 + 0.2 * entry.intersectionRatio}`;
					target.style.opacity = `${0.6 + 0.4 * entry.intersectionRatio}`;
				} else {
					// Reset when not intersecting
					target.style.scale = '0.8 0.8';
					target.style.opacity = '0.6';
				}
			});
		},
		{ threshold: thresholds },
	);

	document.querySelectorAll('.feature').forEach((el) => {
		instance.observe(el);
	});
</script>

<style is:global>
	html {
		overflow: hidden;
	}
</style>

<style scoped>
	.tagline {
		display: grid;
		box-sizing: border-box;
		grid-template-columns: auto 1fr;
		align-items: center;
		gap: 5rem;
		/* margin-bottom: 6rem; */
		padding: 1rem 0;
		min-height: 85vh;
		width: 100% !important;
		scroll-snap-align: start;
		scroll-snap-stop: always;

		.demo {
			height: 100%;
		}

		@media (max-width: 1223px) {
			grid-template-columns: 1fr;
			/* gap: 1rem; */
			margin-bottom: 35rem;
		}

		h1,
		p {
			margin: 0;
		}

		h1 {
			background-image: var(--app-color-primary-gradient);
			background-clip: text;
			-webkit-text-fill-color: transparent;
			font-size: clamp(3rem, 20vw, 8rem);
			line-height: 1.28;
			width: max-content;
		}

		p {
			font-size: clamp(1rem, 5vw, 2rem);
		}
	}

	.group {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
		margin-top: 1rem;

		a[href] {
			display: flex;
			justify-content: center;
			align-items: center;
			gap: 1rem;
			padding: 1rem 2rem;
			border-radius: 1rem !important;
			font-size: 1.4rem;
			text-align: center;
			color: var(--app-color-primary);

			&:hover {
				color: var(--app-color-primary-contrast);
			}

			@media (max-width: 768px) {
				font-size: 1rem;
				padding: 0.5rem 1rem;
			}
		}
	}

	h2 {
		margin: 0;
	}

	main {
		position: relative;
		display: flex;
		flex-direction: column;
		/* align-items: center; */
		z-index: 2;
		padding: 0 1rem;
		width: 100%;
		height: 100%;
		max-height: 100vh;

		overflow: auto;
		overflow-x: hidden;

		scroll-snap-type: y mandatory;
		scroll-padding-top: 1.25rem;

		padding-bottom: 20rem;
	}

	.feature {
		min-height: calc(85vh);
		display: flex;
		box-sizing: border-box;
		/* height: 100%; */
		width: 100%;

		scroll-snap-align: start;
		scroll-snap-stop: always;
		/* scroll-margin-top: 1.25rem; */

		& > div {
			flex: 1;
			background-color: color-mix(in lch, var(--app-color-dark), transparent 98%);
			padding: 2rem;
			border-radius: 1rem;

			border: solid 1px color-mix(in lch, var(--app-color-dark), transparent 80%);

			scale: 0.8 0.8;
			opacity: 0.7;
		}
	}

	.two-col {
		display: flex;
		flex: 1 1 auto;
		/* width: 80%; */
		/* margin-bottom: clamp(3rem, 100vw, 10rem); */

		&:nth-of-type(2n + 1) {
			flex-direction: row-reverse;
		}

		@media (max-width: 1223px) {
			grid-template-columns: 1fr;
			gap: 2rem;
			width: 100%;
			flex-direction: column !important;
		}

		:global(.intro, .demo) {
			flex: 1 1;
		}
	}

	.feature-feature-rich {
		grid-template-columns: 1fr;
		/* margin-bottom: clamp(3rem, 100vw, 10rem); */
	}

	.explore-frameworks {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 4rem;
		padding-bottom: clamp(3rem, 100vw, 10rem);
	}
</style>
