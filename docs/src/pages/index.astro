---
import BundleSizeBuilderFeature from '$components/home/features/bundle-size/BundleSizeBuilderFeature.svelte';
import FeatureRichFeature from '$components/home/features/feature-rich/FeatureRichFeature.svelte';
import MultipleFrameworksFeature from '$components/home/features/multiple-frameworks/MultipleFrameworksFeature.svelte';
import SSRFriendlyFeature from '$components/home/features/ssr-friendly/SSRFriendlyFeature.svelte';
import HeroExample from '$components/home/HeroExample.svelte';
import Layout from '$layouts/Layout.astro';
import { Code } from 'astro/components';
import FeatureContainer from './_components/FeatureContainer.svelte';
---

<Layout title="Neodrag: One draggable to rule them all">
	<main id="main-content">
		<FeatureContainer client:visible unstyled unscaled>
			<section class="tagline">
				<div class="intro">
					<div class="top">
						<h1>Neodrag</h1>
						<p class="h4">One draggable to rule them all</p>
					</div>

					<div class="group">
						<a href="/docs/svelte">Getting Started</a>
						<a href="https://github.com/puruvj/neodrag" target="_blank" rel="external"> Github </a>
					</div>
				</div>

				<div class="demo">
					<HeroExample client:load />
				</div>
			</section>
		</FeatureContainer>

		<FeatureContainer client:visible title="Write Once Run Everywhere">
			<MultipleFrameworksFeature client:visible>
				<div class="svelte">
					<Code
						code={`<script>
  import { draggable } from '@neodrag/svelte';
</script>

<div {@attach draggable()}>I can drag</div>`}
						lang="svelte"
						themes={{
							light: 'github-light',
							dark: 'github-dark',
						}}
						theme={'github-light'}
						wrap={true}
					/>
				</div>

				<div class="react">
					<Code
						code={`import { useDraggable } from '@neodrag/react';

function App() {
  const ref = useRef();
  useDraggable(ref)

  <div ref={ref}>I can drag</div>
}`}
						lang="tsx"
						themes={{
							light: 'github-light',
							dark: 'github-dark',
						}}
						theme={'github-light'}
						wrap={true}
					/>
				</div>

				<div class="solid">
					<Code
						code={`import { useDraggable } from '@neodrag/solid';

function App() {
  const [ref, setRef] = createSignal();
  useDraggable(ref)

  <div ref={setRef}>I can drag</div>
}`}
						lang="tsx"
						themes={{
							light: 'github-light',
							dark: 'github-dark',
						}}
						theme={'github-light'}
						wrap={true}
					/>
				</div>

				<div class="vanilla">
					<Code
						code={`import { Draggable } from '@neodrag/vanilla';
							
const element = document.querySelector('.draggable');
const draggable = new Draggable(element);`}
						lang="tsx"
						themes={{
							light: 'github-light',
							dark: 'github-dark',
						}}
						theme={'github-light'}
						wrap={true}
					/>
				</div>

				<div class="vue">
					<Code
						code={`<script>
  import { vDraggable } from '@neodrag/svelte';
</script>

<div v-draggable>I can drag</div>`}
						lang="vue"
						themes={{
							light: 'github-light',
							dark: 'github-dark',
						}}
						theme={'github-light'}
						wrap={true}
					/>
				</div>
			</MultipleFrameworksFeature>
		</FeatureContainer>

		<FeatureContainer client:visible title="Everything's a plugin!" />

		<FeatureContainer client:visible title="Keep Elements Inside Boundaries" />

		<FeatureContainer client:visible title="Lock Movement To Specific Directions" />

		<FeatureContainer client:visible title="Snap Elements To Perfect Grids" />

		<FeatureContainer client:visible title="Mix And Match Drag Behaviors" />

		<FeatureContainer client:visible title="Handle Thousands With 3 Event Listeners" />

		<FeatureContainer client:visible title="Never Lose Drag Over iframes" />

		<FeatureContainer client:visible title="Production Ready With Zero Dependencies" />

		<FeatureContainer client:visible>
			<BundleSizeBuilderFeature client:visible />
		</FeatureContainer>

		<FeatureContainer client:visible>
			<SSRFriendlyFeature client:visible />
		</FeatureContainer>

		<FeatureContainer client:visible>
			<FeatureRichFeature client:visible />
		</FeatureContainer>

		<FeatureContainer client:visible title="Astro: How many frameworks?">
			<h3 class="h2">Neodrag: Yes</h3>
		</FeatureContainer>
	</main>
</Layout>

<style is:global>
	html {
		overflow: hidden;
	}
</style>

<style scoped>
	.tagline {
		display: grid;
		box-sizing: border-box;
		grid-template-columns: auto 1fr;
		align-items: center;
		gap: 5rem;
		/* margin-bottom: 6rem; */
		padding: 1rem 0;
		min-height: 85dvh;
		width: 100% !important;
		scroll-snap-align: start;
		scroll-snap-stop: always;

		.demo {
			height: 100%;
		}

		@media (max-width: 1223px) {
			grid-template-columns: 1fr;
			grid-template-rows: auto 1fr;
			gap: 3rem;
			/* gap: 1rem; */
			/* margin-bottom: 35rem; */
			align-items: initial;
		}

		h1,
		p {
			margin: 0;
		}

		h1 {
			background-image: var(--app-color-primary-gradient);
			background-clip: text;
			-webkit-text-fill-color: transparent;
			font-size: clamp(3rem, 20vw, 8rem);
			line-height: 1.28;
			width: max-content;
		}

		p {
			font-size: clamp(1rem, 5vw, 2rem);
		}
	}

	.intro {
		display: grid;
		gap: 4rem;

		@media (max-width: 1223px) {
			gap: 1rem;
		}
	}

	.group {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
		margin-top: 1rem;

		a[href] {
			display: flex;
			justify-content: center;
			align-items: center;
			gap: 1rem;
			padding: 1rem 2rem;
			border-radius: 1rem !important;
			font-size: 1.4rem;
			text-align: center;
			color: var(--app-color-primary);

			&:hover {
				color: var(--app-color-primary-contrast);
			}

			@media (max-width: 768px) {
				font-size: 1rem;
				padding: 0.5rem 1rem;
			}
		}
	}

	h2 {
		margin: 0;
	}

	main {
		position: relative;
		display: flex;
		flex-direction: column;
		/* align-items: center; */
		z-index: 2;
		padding: 0 1rem;
		width: 100%;
		height: 100%;
		max-height: 100dvh;

		overflow: auto;
		overflow-x: hidden;

		scroll-snap-type: y mandatory;
		scroll-padding-top: 1.25rem;

		padding-bottom: 20rem;

		@media (max-width: 1223px) {
			scroll-padding-top: 1rem;
		}
	}

	.two-col {
		display: flex;
		flex: 1 1 auto;
		/* width: 80%; */
		/* margin-bottom: clamp(3rem, 100vw, 10rem); */

		&:nth-of-type(2n + 1) {
			flex-direction: row-reverse;
		}

		@media (max-width: 1223px) {
			grid-template-columns: 1fr;
			gap: 2rem;
			width: 100%;
			flex-direction: column !important;
		}

		:global(.intro, .demo) {
			flex: 1 1;
		}
	}

	.feature-feature-rich {
		grid-template-columns: 1fr;
		/* margin-bottom: clamp(3rem, 100vw, 10rem); */
	}

	.explore-frameworks {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 4rem;
		padding-bottom: clamp(3rem, 100vw, 10rem);
	}
</style>
