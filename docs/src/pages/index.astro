---
import { plugins_list } from '$/nav';
import BundleSizeBuilderFeature from '$components/home/features/bundle-size/BundleSizeBuilderFeature.svelte';
import MultipleFrameworksFeature from '$components/home/features/multiple-frameworks/MultipleFrameworksFeature.svelte';
import Layout from '$layouts/Layout.astro';
import { Code } from 'astro/components';
import EverythingIsPlugin from './_components/EverythingIsPlugin.svelte';
import FeatureContainer from './_components/FeatureContainer.svelte';
import Hero from './_components/Hero.svelte';

type Keys =
	| 'HERO'
	| 'WRITE_ONCE_RUN_EVERYWHERE'
	| 'EVERYTHING_IS_PLUGIN'
	| 'BOUNDS'
	| 'AXES'
	| 'SNAP_TO_GRID'
	| 'EVENT_DELEGATION'
	| 'IFRAME_PROOF'
	| 'FEATURES'
	| 'BUNDLE_SIZE'
	| 'WINDOWS_XP'
	| 'DEDUPED';

const SINGLE: Keys | null = null;

function show_single(key: Keys) {
	return SINGLE == null || SINGLE === key;
}
---

<Layout title="Neodrag: One draggable to rule them all">
	<main id="main-content">
		{show_single('HERO') && <Hero client:visible />}

		{
			show_single('WRITE_ONCE_RUN_EVERYWHERE') && (
				<FeatureContainer client:visible title="Write Once Run Everywhere">
					<p slot="subheading">
						Solid core, lean framework adapters ensure same behavior no matter which framework
					</p>

					<MultipleFrameworksFeature client:visible>
						<div class="svelte">
							<Code
								code={`<script>
  import { draggable } from '@neodrag/svelte';
</script>

<div {@attach draggable()}>I can drag</div>`}
								lang="svelte"
								themes={{
									light: 'github-light',
									dark: 'github-dark',
								}}
								theme={'github-light'}
								wrap={true}
							/>
						</div>

						<div class="react">
							<Code
								code={`import { useDraggable } from '@neodrag/react';

function App() {
  const ref = useRef();
  useDraggable(ref)

  <div ref={ref}>I can drag</div>
}`}
								lang="tsx"
								themes={{
									light: 'github-light',
									dark: 'github-dark',
								}}
								theme={'github-light'}
								wrap={true}
							/>
						</div>

						<div class="solid">
							<Code
								code={`import { useDraggable } from '@neodrag/solid';

function App() {
  const [ref, setRef] = createSignal();
  useDraggable(ref)

  <div ref={setRef}>I can drag</div>
}`}
								lang="tsx"
								themes={{
									light: 'github-light',
									dark: 'github-dark',
								}}
								theme={'github-light'}
								wrap={true}
							/>
						</div>

						<div class="vanilla">
							<Code
								code={`import { Draggable } from '@neodrag/vanilla';
							
const element = document.querySelector('.draggable');
const draggable = new Draggable(element);`}
								lang="tsx"
								themes={{
									light: 'github-light',
									dark: 'github-dark',
								}}
								theme={'github-light'}
								wrap={true}
							/>
						</div>

						<div class="vue">
							<Code
								code={`<script>
  import { vDraggable } from '@neodrag/svelte';
</script>

<div v-draggable>I can drag</div>`}
								lang="vue"
								themes={{
									light: 'github-light',
									dark: 'github-dark',
								}}
								theme={'github-light'}
								wrap={true}
							/>
						</div>
					</MultipleFrameworksFeature>
				</FeatureContainer>
			)
		}

		{
			show_single('EVERYTHING_IS_PLUGIN') && (
				<EverythingIsPlugin plugins={plugins_list} client:visible />
			)
		}

		{
			show_single('BOUNDS') && (
				<FeatureContainer client:visible title="Keep Elements Inside Boundaries" />
			)
		}

		{
			show_single('AXES') && (
				<FeatureContainer client:visible title="Lock Movement To Specific Directions" />
			)
		}

		{
			show_single('SNAP_TO_GRID') && (
				<FeatureContainer client:visible title="Snap Elements To Perfect Grids" />
			)
		}

		{
			show_single('EVENT_DELEGATION') && (
				<FeatureContainer client:visible title="Handle Thousands With 3 Event Listeners" />
			)
		}

		{
			show_single('IFRAME_PROOF') && (
				<FeatureContainer client:visible title="Never Lose Drag Over iframes" />
			)
		}

		{
			show_single('BUNDLE_SIZE') && (
				<FeatureContainer client:visible>
					<BundleSizeBuilderFeature client:visible />
				</FeatureContainer>
			)
		}

		<!-- TODO: And more features: This bit just lists other features in this page, including SSR Proof, zero dependencies, etc. Actually list eveyrthing in svelte.dev like style -->
		{
			show_single('FEATURES') && (
				<FeatureContainer client:visible title="Production Ready With Zero Dependencies" />
			)
		}

		<!-- This is to open multiple windows in windows Xp style and to show its all super fast -->
		{
			show_single('WINDOWS_XP') && (
				<FeatureContainer client:visible title="Go ahead, enjoy the OS" />
			)
		}
		<!-- <FeatureContainer client:visible>
			<FeatureRichFeature client:visible />
		</FeatureContainer> -->

		{
			show_single('DEDUPED') && (
				<FeatureContainer client:visible title="Astro: How many frameworks?">
					<h3 class="h2">Neodrag: Yes</h3>
				</FeatureContainer>
			)
		}
	</main>
</Layout>

<style is:global>
	html {
		overflow: hidden;
	}
</style>

<style scoped>
	h2 {
		margin: 0;
	}

	main {
		position: relative;
		display: flex;
		flex-direction: column;
		/* align-items: center; */
		z-index: 2;
		padding: 0 1rem;
		width: 100%;
		height: 100%;
		max-height: 100dvh;

		overflow: auto;
		overflow-x: hidden;

		scroll-snap-type: y mandatory;
		scroll-padding-top: 1.25rem;

		padding-bottom: 20rem;

		@media (max-width: 1223px) {
			scroll-padding-top: 1rem;
		}
	}

	.two-col {
		display: flex;
		flex: 1 1 auto;
		/* width: 80%; */
		/* margin-bottom: clamp(3rem, 100vw, 10rem); */

		&:nth-of-type(2n + 1) {
			flex-direction: row-reverse;
		}

		@media (max-width: 1223px) {
			grid-template-columns: 1fr;
			gap: 2rem;
			width: 100%;
			flex-direction: column !important;
		}

		:global(.intro, .demo) {
			flex: 1 1;
		}
	}

	.feature-feature-rich {
		grid-template-columns: 1fr;
		/* margin-bottom: clamp(3rem, 100vw, 10rem); */
	}

	.explore-frameworks {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 4rem;
		padding-bottom: clamp(3rem, 100vw, 10rem);
	}
</style>
