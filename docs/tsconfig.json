{
	"extends": "astro/tsconfigs/strict",
	"compilerOptions": {
		"strictNullChecks": true,
		"paths": {
			"$layouts/*": ["./src/layouts/*"],
			"$components/*": ["./src/components/*"],
			"$state/*": ["./src/state/*"],
			"$attachments/*": ["./src/attachments/*"],
			"$helpers/*": ["./src/helpers/*"],
			"$/*": ["./src/*"]
		}
	},
	"include": [".astro/types.d.ts", "**/*"],
	"exclude": ["dist"]
}
