{
	"name": "neodrag",
	"version": "1.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"changeset": "changeset",
		"compile": "vp run -r compile",
		"build": "vp run -r build",
		"dev": "vp run -r dev",
		"docs:build": "vp run -r compile && vp run -F docs build",
		"test": "vp run -r test",
		"test:adapters": "vp run -F @neodrag/svelte -F @neodrag/react -F @neodrag/vue -F @neodrag/solid test",
		"test:ci": "vp run -F @neodrag/core test && vp run -F @neodrag/svelte -F @neodrag/react -F @neodrag/vue -F @neodrag/solid test",
		"ci:version": "changeset version",
		"ci:release": "changeset publish",
		"check": "vp check",
		"format": "vp fmt",
		"format:check": "vp fmt --check"
	},
	"devDependencies": {
		"@astrojs/compiler": "^4.0.0",
		"@changesets/changelog-github": "^0.5.1",
		"@changesets/cli": "^2.29.5",
		"@sveltejs/vite-plugin-svelte": "5.1.0",
		"@types/node": "^22.12.0",
		"@types/react": "^18.3.23",
		"@types/react-dom": "^18.3.7",
		"@vitest/browser": "^4.1.8",
		"@vitest/browser-playwright": "^4.1.8",
		"playwright": "^1.53.1",
		"svelte": "^5.43.6",
		"tsdown": "catalog:",
		"tsx": "^4.20.3",
		"typescript": "catalog:",
		"vite-plus": "^0.1.24",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"packageManager": "pnpm@10.12.0",
	"pnpm": {
		"overrides": {
			"vite": "catalog:"
		},
		"onlyBuiltDependencies": [
			"@parcel/watcher",
			"@sveltejs/kit",
			"esbuild",
			"sharp"
		]
	}
}
