{
	"name": "neodrag",
	"version": "1.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"changeset": "changeset",
		"compile": "turbo run compile",
		"build": "turbo run build",
		"dev": "turbo run dev",
		"docs:build": "turbo run docs#build",
		"sizes": "turbo run sizes",
		"bench": "turbo run bench --filter=@neodrag/core",
		"test": "turbo run test",
		"test:unit": "turbo run test:unit --filter=@neodrag/core",
		"test:bench:guard": "turbo run test:bench:guard --filter=@neodrag/core",
		"test:adapters": "turbo run test --filter=@neodrag/svelte --filter=@neodrag/react --filter=@neodrag/vue --filter=@neodrag/solid",
		"test:ci": "turbo run test:webkit test:firefox test:unit test:bench:guard test:coverage --filter=@neodrag/core && turbo run test --filter=@neodrag/svelte --filter=@neodrag/react --filter=@neodrag/vue --filter=@neodrag/solid",
		"ci:version": "changeset version",
		"ci:release": "changeset publish",
		"format": "oxfmt",
		"format:check": "oxfmt --check"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^0.5.1",
		"@changesets/cli": "^2.29.5",
		"@sveltejs/vite-plugin-svelte": "5.1.0",
		"@types/react": "^18.3.23",
		"@types/react-dom": "^18.3.7",
		"@vitest/browser": "^3.2.4",
		"oxfmt": "^0.52.0",
		"playwright": "^1.53.1",
		"svelte": "^5.43.6",
		"tsdown": "catalog:",
		"tsx": "^4.20.3",
		"turbo": "^2.9.14",
		"typescript": "catalog:",
		"vitest": "^3.2.4",
		"vitest-browser-svelte": "^1.0.0"
	},
	"packageManager": "pnpm@10.12.0",
	"pnpm": {
		"overrides": {
			"vite": "catalog:"
		},
		"onlyBuiltDependencies": [
			"@parcel/watcher",
			"@sveltejs/kit",
			"esbuild",
			"sharp"
		]
	}
}
