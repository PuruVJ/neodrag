{
	"name": "@neodrag/core",
	"version": "3.0.0-next.8",
	"type": "module",
	"files": [
		"dist/*"
	],
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./plugins": {
			"types": "./src/plugins.ts",
			"import": "./src/plugins.ts"
		},
		"./drop": {
			"types": "./src/drop/index.ts",
			"import": "./src/drop/index.ts"
		},
		"./drop/plugins": {
			"types": "./src/drop/plugins.ts",
			"import": "./src/drop/plugins.ts"
		},
		"./interactions": {
			"types": "./src/interactions/index.ts",
			"import": "./src/interactions/index.ts"
		},
		"./interactions/drop": {
			"types": "./src/interactions/drop/index.ts",
			"import": "./src/interactions/drop/index.ts"
		},
		"./interactions/sortable": {
			"types": "./src/interactions/sortable/index.ts",
			"import": "./src/interactions/sortable/index.ts"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js"
			},
			"./plugins": {
				"types": "./dist/plugins.d.ts",
				"import": "./dist/plugins.js"
			},
			"./drop": {
				"types": "./dist/drop/index.d.ts",
				"import": "./dist/drop/index.js"
			},
			"./drop/plugins": {
				"types": "./dist/drop/plugins.d.ts",
				"import": "./dist/drop/plugins.js"
			},
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"compile:watch": "tsup --watch",
		"compile": "tsup",
		"prepublishOnly": "npm run compile",
		"test": "vitest",
		"test:interactions": "vitest run --config vitest.interactions.config.ts",
		"test:interactions:unit": "vitest run tests/interactions/state-machine.test.ts tests/interactions/update.test.ts tests/interactions/plugins-phases.test.ts tests/interactions/coalescing.test.ts --browser.enabled=false",
		"test:bench:guard": "vitest run --config vitest.bench.browser.config.ts benchmarks/browser/behavioral.guard.test.ts benchmarks/browser/perf.suite.test.ts",
		"bench": "vitest run --config vitest.bench.browser.config.ts benchmarks/browser/perf.suite.test.ts",
		"bench:browser": "vitest run --config vitest.bench.browser.config.ts",
		"bench:all": "pnpm test:bench:guard",
		"bench:run": "pnpm test:bench:guard",
		"test:coverage": "vitest run --coverage --browser=chromium"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/PuruVJ/neodrag.git"
	},
	"author": "Puru Vijay",
	"license": "MIT",
	"devDependencies": {
		"@vitest/coverage-v8": "3.2.4",
		"jsdom": "^29.1.1"
	}
}
