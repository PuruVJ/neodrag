		},
		"./sortable": {
			"types": "./src/sortable/index.ts",
			"import": "./src/sortable/index.ts"
		},
		"./resize": {
			"types": "./src/resize/index.ts",
			"import": "./src/resize/index.ts"
		},
		"./rotate": {
			"types": "./src/rotate/index.ts",
			"import": "./src/rotate/index.ts"
		},
		"./drop": {
			"types": "./src/drop/index.ts",
			"import": "./src/drop/index.ts"
		},
		"./splitpane": {
			"types": "./src/splitpane/index.ts",
			"import": "./src/splitpane/index.ts"
		},
		"./panzoom": {
			"types": "./src/panzoom/index.ts",
			"import": "./src/panzoom/index.ts"
		},
		"./swipe": {
			"types": "./src/swipe/index.ts",
			"import": "./src/swipe/index.ts"
		},
