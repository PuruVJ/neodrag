{
	"name": "@neodrag/core",
	"version": "3.0.0-next.8",
	"type": "module",
	"files": [
		"dist/*"
	],
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./plugins": {
			"types": "./src/plugins.ts",
			"import": "./src/plugins.ts"
		},
		"./drop": {
			"types": "./src/drop/index.ts",
			"import": "./src/drop/index.ts"
		},
		"./drop/plugins": {
			"types": "./src/drop/plugins.ts",
			"import": "./src/drop/plugins.ts"
		},
		"./interactions": {
			"types": "./src/interactions/index.ts",
			"import": "./src/interactions/index.ts"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js"
			},
			"./plugins": {
				"types": "./dist/plugins.d.ts",
				"import": "./dist/plugins.js"
			},
			"./drop": {
				"types": "./dist/drop/index.d.ts",
				"import": "./dist/drop/index.js"
			},
			"./drop/plugins": {
				"types": "./dist/drop/plugins.d.ts",
				"import": "./dist/drop/plugins.js"
			},
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"compile:watch": "tsup --watch",
		"compile": "tsup",
		"prepublishOnly": "npm run compile",
		"test": "vitest",
		"test:coverage": "vitest run --coverage --browser=chromium"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/PuruVJ/neodrag.git"
	},
	"author": "Puru Vijay",
	"license": "MIT",
	"devDependencies": {
		"@vitest/coverage-v8": "3.2.4"
	}
}
