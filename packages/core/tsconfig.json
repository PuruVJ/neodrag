{
	"compilerOptions": {
		"module": "ES2022",
		"target": "ESNext",
		"noEmit": true,
		"strict": true,
		"lib": [
			"ESNext",
			"DOM",
			"DOM.Iterable"
		],
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"types": [
			"node",
			"vitest/importMeta"
		]
	},
	"include": [
		"./src/**/*.ts"
	]
}
