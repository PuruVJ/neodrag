{
	"name": "@neodrag/solid",
	"version": "3.0.0-next.9",
	"description": "SolidJS library to add dragging to your apps 😉",
	"keywords": [
		"drag",
		"draggable",
		"neodrag",
		"performant",
		"react-draggable",
		"small",
		"solid",
		"tiny"
	],
	"homepage": "https://github.com/PuruVJ/neodrag/tree/main/packages/solid#readme",
	"bugs": {
		"url": "https://github.com/PuruVJ/neodrag/issues"
	},
	"license": "MIT",
	"author": "Puru Vijay",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/PuruVJ/neodrag.git"
	},
	"files": [
		"dist/*"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./plugins": {
			"types": "./src/plugins.ts",
			"import": "./src/plugins.ts",
			"default": "./src/plugins.ts"
		},
		"./drop": {
			"types": "./src/drop/index.ts",
			"import": "./src/drop/index.ts",
			"default": "./src/drop/index.ts"
		},
		"./sortable": {
			"types": "./src/sortable/index.ts",
			"import": "./src/sortable/index.ts",
			"default": "./src/sortable/index.ts"
		},
		"./resize": {
			"types": "./src/resize.ts",
			"import": "./src/resize.ts",
			"default": "./src/resize.ts"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js",
				"default": "./dist/index.js"
			},
			"./plugins": {
				"types": "./dist/plugins.d.ts",
				"import": "./dist/plugins.js",
				"default": "./dist/plugins.js"
			},
			"./drop": {
				"types": "./dist/drop/index.d.ts",
				"import": "./dist/drop/index.js",
				"default": "./dist/drop/index.js"
			},
			"./sortable": {
				"types": "./dist/sortable/index.d.ts",
				"import": "./dist/sortable/index.js",
				"default": "./dist/sortable/index.js"
			},
			"./resize": {
				"types": "./dist/resize.d.ts",
				"import": "./dist/resize.js",
				"default": "./dist/resize.js"
			},
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"compile": "tsdown",
		"prepublishOnly": "turbo compile",
		"test": "vitest run --config vitest.config.ts"
	},
	"devDependencies": {
		"@neodrag/core": "workspace:*",
		"@vitest/browser": "^3.2.4",
		"playwright": "^1.53.1",
		"solid-js": "^1.9.7",
		"tsdown": "catalog:",
		"vite-plugin-solid": "^2.11.6",
		"vitest": "^3.2.4"
	},
	"peerDependencies": {
		"@neodrag/core": "workspace:*",
		"solid-js": "^1.0.0"
	}
}
