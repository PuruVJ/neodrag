{
	"name": "@neodrag/svelte",
	"version": "3.0.0-next.9",
	"description": "Svelte Action to add dragging to your apps 😉",
	"type": "module",
	"files": [
		"dist/*"
	],
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./src/index.svelte.ts",
			"svelte": "./src/index.svelte.ts",
			"import": "./src/index.svelte.ts",
			"default": "./src/index.svelte.ts"
		},
		"./plugins": {
			"types": "./src/plugins.ts",
			"svelte": "./src/plugins.ts",
			"import": "./src/plugins.ts",
			"default": "./src/plugins.ts"
		},
		"./drop": {
			"types": "./src/drop/index.svelte.ts",
			"svelte": "./src/drop/index.svelte.ts",
			"import": "./src/drop/index.svelte.ts",
			"default": "./src/drop/index.svelte.ts"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.svelte.d.ts",
				"svelte": "./dist/index.svelte.js",
				"import": "./dist/index.svelte.js",
				"default": "./dist/index.svelte.js"
			},
			"./plugins": {
				"types": "./dist/plugins.d.ts",
				"import": "./dist/plugins.js",
				"default": "./dist/plugins.js"
			},
			"./drop": {
				"types": "./dist/drop/index.svelte.d.ts",
				"svelte": "./dist/drop/index.svelte.js",
				"import": "./dist/drop/index.svelte.js",
				"default": "./dist/drop/index.svelte.js"
			},
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"compile": "tsup",
		"prepublishOnly": "turbo compile",
		"test": "vitest run --config vitest.config.ts"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/PuruVJ/neodrag.git"
	},
	"keywords": [
		"draggable",
		"svelte",
		"react-draggable",
		"drag",
		"svelte",
		"small",
		"tiny",
		"performant",
		"neodrag"
	],
	"author": "Puru Vijay",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/PuruVJ/neodrag/issues"
	},
	"peerDependencies": {
		"svelte": "^3 || ^4 || ^5",
		"@neodrag/core": "workspace:*"
	},
	"homepage": "https://neodrag.dev/docs/svelte",
	"devDependencies": {
		"@neodrag/core": "workspace:*",
		"@sveltejs/vite-plugin-svelte": "5.1.0",
		"@vitest/browser": "^3.2.4",
		"playwright": "^1.53.1",
		"svelte": "^5.33.1",
		"vitest": "^3.2.4",
		"vitest-browser-svelte": "^1.0.0"
	}
}
