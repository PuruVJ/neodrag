{
	"compilerOptions": {
		"module": "ESNext",
		"target": "ESNext",
		"declaration": true,
		"emitDeclarationOnly": true,
		"declarationDir": "dist",
		"strict": true,
		"esModuleInterop": true,
		"moduleResolution": "Bundler",
		"allowImportingTsExtensions": true,
		"rootDir": "src"
	},
	"include": ["src/**/*.ts"]
}
