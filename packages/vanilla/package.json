{
	"name": "@neodrag/vanilla",
	"version": "3.0.0-next.9",
	"description": "JS library to add dragging to your apps 😉",
	"keywords": [
		"drag",
		"draggable",
		"javascript",
		"neodrag",
		"performant",
		"react-draggable",
		"small",
		"tiny",
		"typescript",
		"vanilla"
	],
	"homepage": "https://github.com/PuruVJ/neodrag/tree/main/packages/vanilla#readme",
	"bugs": {
		"url": "https://github.com/PuruVJ/neodrag/issues"
	},
	"license": "MIT",
	"author": "Puru Vijay",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/PuruVJ/neodrag.git"
	},
	"files": [
		"dist/*"
	],
	"type": "module",
	"sideEffects": false,
	"unpkg": "./dist/umd/index.js",
	"jsdelivr": "./dist/umd/index.js",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./plugins": {
			"types": "./src/plugins.ts",
			"import": "./src/plugins.ts",
			"default": "./src/plugins.ts"
		},
		"./drop": {
			"types": "./src/drop.ts",
			"import": "./src/drop.ts",
			"default": "./src/drop.ts"
		},
		"./sortable": {
			"types": "./src/sortable.ts",
			"import": "./src/sortable.ts",
			"default": "./src/sortable.ts"
		},
		"./resize": {
			"types": "./src/resize.ts",
			"import": "./src/resize.ts"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js",
				"default": "./dist/index.js"
			},
			"./plugins": {
				"types": "./dist/plugins.d.ts",
				"import": "./dist/plugins.js",
				"default": "./dist/plugins.js"
			},
			"./drop": {
				"types": "./dist/drop.d.ts",
				"import": "./dist/drop.js",
				"default": "./dist/drop.js"
			},
			"./sortable": {
				"types": "./dist/sortable.d.ts",
				"import": "./dist/sortable.js",
				"default": "./dist/sortable.js"
			},
			"./resize": {
				"types": "./dist/resize.d.ts",
				"import": "./dist/resize.js",
				"default": "./dist/resize.js"
			},
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"compile": "tsdown",
		"compile:watch": "tsdown --watch",
		"prepublishOnly": "turbo compile",
		"pub": "pnpm compile && pnpm publish --no-git-checks --access public",
		"pub:dry": "pnpm compile && pnpm publish --dry-run --no-git-checks --access public"
	},
	"devDependencies": {
		"@neodrag/core": "workspace:*",
		"tsdown": "catalog:"
	},
	"peerDependencies": {
		"@neodrag/core": "workspace:*"
	}
}
