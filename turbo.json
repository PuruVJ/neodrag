{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": ["pnpm-lock.yaml", "pnpm-workspace.yaml"],
	"tasks": {
		"compile": {
			"dependsOn": ["^compile"],
			"outputs": ["dist/**"],
			"inputs": ["src/**", "tsdown.config.ts", "package.json", "tsconfig.json"]
		},
		"test": {
			"dependsOn": ["^compile"],
			"cache": false,
			"inputs": ["src/**", "tests/**", "benchmarks/**", "vitest*.config.ts", "package.json"]
		},
		"test:webkit": {
			"dependsOn": ["^compile"],
			"cache": false,
			"inputs": ["src/**", "tests/**", "vitest*.config.ts"]
		},
		"test:firefox": {
			"dependsOn": ["^compile"],
			"cache": false,
			"inputs": ["src/**", "tests/**", "vitest*.config.ts"]
		},
		"test:chromium": {
			"dependsOn": ["^compile"],
			"cache": false,
			"inputs": ["src/**", "tests/**", "vitest*.config.ts"]
		},
		"test:unit": {
			"dependsOn": ["^compile"],
			"inputs": ["src/**", "tests/interactions/**", "vitest.config.ts"]
		},
		"test:bench:guard": {
			"dependsOn": ["^compile"],
			"cache": false,
			"inputs": ["src/**", "benchmarks/**", "vitest.bench.browser.config.ts"]
		},
		"test:coverage": {
			"dependsOn": ["^compile"],
			"outputs": ["coverage/**"],
			"cache": false,
			"inputs": ["src/**", "tests/**", "vitest*.config.ts"]
		},
		"bench": {
			"dependsOn": ["^compile"],
			"cache": false,
			"inputs": ["src/**", "benchmarks/**", "vitest.bench.browser.config.ts"]
		},
		"sizes": {
			"dependsOn": ["^compile"],
			"outputs": ["../src/sizes.json"],
			"inputs": ["sizes.ts", "package.json"]
		},
		"build": {
			"dependsOn": ["^compile"],
			"outputs": ["dist/**", ".astro/**"],
			"inputs": ["src/**", "public/**", "astro.config.*", "package.json"]
		},
		"dev": {
			"dependsOn": ["^compile"],
			"cache": false,
			"persistent": true,
			"inputs": ["src/**", "tsdown.config.ts", "vite.config.*", "package.json"]
		},
		"docs#build": {
			"dependsOn": ["^compile", "sizes"],
			"outputs": ["dist/**"]
		}
	},
	"ui": "tui"
}
